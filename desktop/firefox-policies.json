{
  "policies": {
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "DontCheckDefaultBrowser": true,
    "DisableTelemetry": true,
    "DisableFirefoxAccounts": true,
    "DisablePocket": true,
    "NoDefaultBookmarks": true,
    "Homepage": {
      "URL": "https://kubernetes.io/docs/home/",
      "StartPage": "homepage",
      "Locked": false
    },
    "Bookmarks": [
      {
        "Title": "Kubernetes Docs",
        "URL": "https://kubernetes.io/docs/home/",
        "Placement": "toolbar"
      },
      {
        "Title": "kubectl Cheat Sheet",
        "URL": "https://kubernetes.io/docs/reference/kubectl/quick-reference/",
        "Placement": "toolbar"
      },
      {
        "Title": "Helm Docs",
        "URL": "https://helm.sh/docs/",
        "Placement": "toolbar"
      },
      {
        "Title": "Gateway API",
        "URL": "https://gateway-api.sigs.k8s.io/docs/",
        "Placement": "toolbar"
      },
      {
        "Title": "LF: resources allowed",
        "URL": "https://docs.linuxfoundation.org/tc-docs/certification/certification-resources-allowed",
        "Placement": "menu"
      }
    ],
    "WebsiteFilter": {
      "Block": ["<all_urls>"],
      "Exceptions": [
        "https://kubernetes.io/*",
        "https://*.kubernetes.io/*",
        "https://helm.sh/*",
        "https://*.helm.sh/*",
        "https://gateway-api.sigs.k8s.io/*",
        "https://k8s.io/*",
        "https://*.k8s.io/*",
        "https://code.jquery.com/*",
        "https://unpkg.com/*",
        "https://cdnjs.cloudflare.com/*",
        "https://fonts.googleapis.com/*",
        "https://fonts.gstatic.com/*",
        "https://docs.linuxfoundation.org/*"
      ]
    }
  }
}
